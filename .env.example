# YelloFC USSD runtime configuration
# Keep real values in .env only. Never commit credentials.

DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

PISI_BASE_URL=https://api.pisimobile.net
VASPID=

# Canonical YelloFC Web/CMS API. When configured, USSD fixtures/questions
# are read from the same published rounds as the Web experience.
YELLOFC_API_BASE_URL=https://staging.yellofc.com

# Set YES after the CMS bridge is certified. With YES, the USSD service
# fails closed instead of falling back to legacy local fixture tables.
YELLOFC_CMS_REQUIRED=NO

# Staging only, if staging.yellofc.com remains behind Basic Auth.
# Leave blank in production.
YELLOFC_API_BASIC_USER=
YELLOFC_API_BASIC_PASS=

# Canonical USSD -> PostgreSQL entry bridge.
# Enable only after the YelloFC backend bridge is deployed with the same secret.
YELLOFC_ENABLE_ENTRY_BRIDGE=NO
YELLOFC_USSD_BRIDGE_PATH=/api/integrations/ussd/entries
YELLOFC_USSD_POINTS_PATH=/api/integrations/ussd/points
YELLOFC_USSD_BRIDGE_SECRET=replace-with-same-long-random-secret-as-backend
